@{
    var title = ViewData["Title"] as string ?? Lang.T(
        "Majestic Roofing | Roof Insurance Claims Charlotte & Rock Hill",
        "Majestic Roofing | Reclamos de seguro de techo Charlotte y Rock Hill");
    var description = ViewData["MetaDescription"] as string ?? Lang.T(
        "Bilingual roof insurance claim documentation, free storm inspections, roof replacement, repairs, emergency tarping, gutters and fascia across Charlotte, NC and Rock Hill, SC.",
        "Documentación bilingüe de reclamos de seguro de techo, inspecciones de tormenta gratis, reemplazo, reparaciones, tarps de emergencia, canaletas y fascia en Charlotte, NC y Rock Hill, SC.");
    var robots = ViewData["Robots"] as string ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
    var ogType = ViewData["OgType"] as string ?? "website";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var baseUrl = PublicUrl.Base(Context.Request);
    var path = string.IsNullOrEmpty(Context.Request.Path.Value) ? "/" : Context.Request.Path.Value!;
    var canonical = path == "/" ? baseUrl + "/" : baseUrl + path;
    var locale = Lang.IsSpanish ? "es_US" : "en_US";
    var localeAlt = Lang.IsSpanish ? "en_US" : "es_US";
    var ogImage = ViewData["OgImage"] as string ?? baseUrl + "/img/projects/roof-project-11.jpeg";
    var isHome = Context.Request.Path == "/" || string.Equals(Context.Request.Path, "/Home", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Context.Request.Path, "/Home/Index", StringComparison.OrdinalIgnoreCase);
    var isOps = Context.Request.Path.StartsWithSegments("/ops", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@Lang.HtmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="robots" content="@robots" />
    <meta name="author" content="@SiteInfo.Name" />
    <meta name="geo.region" content="US-NC" />
    <meta name="geo.placename" content="Charlotte" />
    <meta name="geo.position" content="35.2271;-80.8431" />
    <meta name="ICBM" content="35.2271, -80.8431" />
    <link rel="canonical" href="@canonical" />
    <link rel="alternate" hreflang="en" href="@canonical" />
    <link rel="alternate" hreflang="es" href="@canonical" />
    <link rel="alternate" hreflang="x-default" href="@canonical" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="@baseUrl/sitemap.xml" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:site_name" content="@SiteInfo.ShortName" />
    <meta property="og:locale" content="@locale" />
    <meta property="og:locale:alternate" content="@localeAlt" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:image:alt" content="@(ViewData["OgImageAlt"] as string ?? Lang.T("Majestic Roofing completed architectural shingle roof project in the Charlotte area", "Proyecto de techo con shingles arquitectónicos de Majestic Roofing en el área de Charlotte"))" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />
    <meta name="twitter:image:alt" content="@(ViewData["OgImageAlt"] as string ?? Lang.T("Majestic Roofing completed architectural shingle roof project in the Charlotte area", "Proyecto de techo con shingles arquitectónicos de Majestic Roofing en el área de Charlotte"))" />
    <meta name="theme-color" content="#17324d" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">@Lang.T("Skip to content", "Ir al contenido")</a>
    <div class="sandbox-banner">
        <div class="site-shell emergency-inner">
            <span><strong>@Lang.T("Sandbox demo", "Demo sandbox")</strong> · @Lang.T("Leads stay in memory only.", "Los leads solo viven en memoria.") · <a href="/ops">@Lang.T("Internal leads", "Leads internos")</a></span>
        </div>
    </div>
    <div class="emergency-bar">
        <div class="site-shell emergency-inner">
            <span>@Lang.T("Active roof leak or storm damage?", "¿Gota activa o daño por tormenta?")</span>
            <a href="@(isHome ? "#emergency" : "/#emergency")">@Lang.T("Emergency tarp details", "Detalles del tarp de emergencia") <span aria-hidden="true">↗</span></a>
        </div>
    </div>
    <header class="site-header">
        <div class="site-shell header-inner">
            <a class="brand" href="@(isHome ? "#top" : "/")" aria-label="Majestic Roofing home">
                <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
                <span><strong>MAJESTIC</strong><small>ROOFING, INC.</small></span>
            </a>
            <nav aria-label="@Lang.T("Primary navigation", "Navegación principal")">
                <a href="@(isHome ? "#services" : "/#services")">@Lang.T("Services", "Servicios")</a>
                <a href="@(isHome ? "#planner" : "/#planner")">@Lang.T("Price planner", "Calculadora")</a>
                <a href="/roof-insurance-claim-charlotte-nc">@Lang.T("Storm damage", "Daño por tormenta")</a>
            </nav>
            <div class="header-actions">
                <a class="language-toggle" href="@Url.Action("Set", "Language", new { code = Lang.OtherCode, returnUrl })">@Lang.ToggleLabel</a>
                <a class="header-phone" href="tel:@SiteInfo.PhoneTel" aria-label="@Lang.T("Call Majestic", "Llamar a Majestic") @SiteInfo.PhoneDisplay">@SiteInfo.PhoneDisplay</a>
                <a class="button button-small" href="@(isHome ? "#contact" : "/#contact")">@Lang.T("Get help", "Pedir ayuda")</a>
            </div>
        </div>
    </header>

    <main lang="@Lang.HtmlLang">
        @if (TempData["LeadOk"] != null)
        {
            <div class="site-shell" style="padding-top:1rem">
                <p class="form-note" style="background:#e8f5e9;padding:0.85rem 1rem;border-radius:8px;color:#1b4332">
                    @Lang.T("Thanks — Majestic received your request. This sandbox only stores it in memory.", "Gracias — Majestic recibió tu solicitud. Este sandbox solo la guarda en memoria.")
                </p>
            </div>
        }
        @if (TempData["LeadError"] != null)
        {
            <div class="site-shell" style="padding-top:1rem">
                <p class="form-note" style="background:#fdecea;padding:0.85rem 1rem;border-radius:8px;color:#7f1d1d">
                    @Lang.T("Please complete the required fields and try again.", "Completa los campos requeridos e inténtalo de nuevo.")
                </p>
            </div>
        }
        @RenderBody()
        @if (!isHome && !isOps)
        {
            @await Html.PartialAsync("_RelatedSeoLinks")
        }
    </main>

    @if (!isOps)
    {
        @await Html.PartialAsync("_SiteClosing")
        @await Html.PartialAsync("_JsonLd")
    }
    @if (isHome)
    {
        @await Html.PartialAsync("_FaqJsonLd")
    }
    else if (!isOps)
    {
        @await Html.PartialAsync("_PageJsonLd")
    }

    <footer class="site-footer">
        <div class="site-shell footer-top">
            <div class="footer-brand">
                <a class="brand brand-footer" href="/">
                    <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span><strong>MAJESTIC</strong><small>ROOFING, INC.</small></span>
                </a>
                <p>@Lang.T("Roof replacement, repairs, storm documentation, emergency tarping, gutters and fascia across Charlotte and Rock Hill.", "Reemplazo, reparaciones, documentación de tormentas, tarps de emergencia, canaletas y fascia en Charlotte y Rock Hill.")</p>
                <a class="footer-email" href="mailto:@SiteInfo.Email">@SiteInfo.Email</a>
            </div>
            <div class="footer-links">
                <div>
                    <p>@Lang.T("Explore", "Explorar")</p>
                    <a href="@(isHome ? "#services" : "/#services")">@Lang.T("Services", "Servicios")</a>
                    <a href="@(isHome ? "#planner" : "/#planner")">@Lang.T("Price planner", "Calculadora")</a>
                    <a href="/roofing-systems-charlotte-nc">@Lang.T("Roofing systems", "Sistemas de techo")</a>
                    <a href="@(isHome ? "#contact" : "/#contact")">@Lang.T("Contact", "Contacto")</a>
                </div>
                <div>
                    <p>@Lang.T("Storm damage", "Daño por tormenta")</p>
                    <a href="/roof-insurance-claim-charlotte-nc">@Lang.T("Insurance claim", "Reclamo de seguro")</a>
                    <a href="/hail-damage-roof-inspection-charlotte-nc">@Lang.T("Hail inspection", "Inspección de granizo")</a>
                    <a href="/wind-missing-shingles-repair-charlotte-nc">@Lang.T("Wind / missing shingles", "Viento / shingles faltantes")</a>
                    <a href="/active-roof-leak-repair-charlotte-nc">@Lang.T("Active leak", "Gota activa")</a>
                </div>
                <div>
                    <p>@Lang.T("Contact", "Contacto")</p>
                    <a href="tel:@SiteInfo.PhoneTel">@Lang.T("Call", "Llamar") @SiteInfo.PhoneDisplay</a>
                    <a href="mailto:@SiteInfo.Email">Email</a>
                    <a href="/roofing-charlotte-nc">Charlotte, NC</a>
                    <a href="/roofing-rock-hill-sc">Rock Hill, SC</a>
                    <a href="/ops">@Lang.T("Ops / leads", "Ops / leads")</a>
                </div>
            </div>
        </div>
        <div class="site-shell footer-bottom">
            <span>© @DateTime.UtcNow.Year Majestic Roofing, Inc.</span>
            <span>@Lang.T("Sandbox website. Leads stay in memory only.", "Website sandbox. Los leads solo viven en memoria.")</span>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
