@model ErrorViewModel
@{
    ViewData["Title"] = Lang.T("Error", "Error");
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["MetaDescription"] = Lang.T("An error occurred.", "Ocurrió un error.");
}

<h1 class="text-danger">@Lang.T("Error.", "Error.")</h1>
<h2 class="text-danger">@Lang.T("An error occurred while processing your request.", "Ocurrió un error al procesar tu solicitud.")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
